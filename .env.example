# Copy to .env and fill in. Used by docker-compose on the droplet.

# Auth: generate with `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# Resend (https://resend.com) - free tier is 3000 emails/month.
# Leave RESEND_API_KEY empty to run without email notifications.
# EMAIL_FROM must be an address on a domain you've verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=alerts@stoutoilandgas.com

# Public URL of the app (used in email links) - required
BASE_URL=http://your-droplet-ip

# CORS - the origin the frontend is served from (same host when all-in-one)
ALLOWED_ORIGINS=http://your-droplet-ip

# Set to false to lock down new account creation after you've signed up
ALLOW_SIGNUP=true
